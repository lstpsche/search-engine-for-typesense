#!/usr/bin/env ruby
# frozen_string_literal: true

ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../../../Gemfile', __dir__)
require 'bundler/setup'
$LOAD_PATH.unshift File.expand_path('../../../lib', __dir__)
require_relative '../lib/docs/query_examples'

unknown = ARGV - %w[--live --auto-embedding]
abort "Unknown options: #{unknown.join(', ')}" unless unknown.empty?

Docs::QueryExamples.run(live: ARGV.include?('--live'), auto_embedding: ARGV.include?('--auto-embedding'))
